---
const items = [
  "IT Development",
  "Brand & PR",
  "Store Launch",
  "Talent Growth",
  "Community Design",
  "Logistics",
];
---
<section class="border-y border-line py-6 overflow-hidden bg-bg">
  <div class="flex marquee-track whitespace-nowrap">
    {[...items, ...items, ...items].map((item) => (
      <span class="font-serif text-3xl md:text-5xl italic mx-8 md:mx-12 text-ink">
        {item}
        <span class="not-italic font-sans text-2xl md:text-3xl mx-8 md:mx-12 opacity-30">✦</span>
      </span>
    ))}
  </div>
</section>
<style>
  :root { --color-bg: #ffffff; --color-line: #e8e6e0; --color-ink: #0a0a0a; }
</style>
