<section id="contact" class="py-32 md:py-48 border-t border-line">
  <div class="container-x">
    <div class="grid grid-cols-12 gap-8">
      <div class="col-span-12 md:col-span-3">
        <p class="text-eyebrow">05 — Contact</p>
      </div>
      <div class="col-span-12 md:col-span-9">
        <h2 class="text-display text-[40px] md:text-[64px] lg:text-[88px] text-ink max-w-4xl">
          Let's talk.
        </h2>
        <p class="mt-6 text-[16px] md:text-[18px] text-ink-2 max-w-2xl font-light leading-[1.8]">
          新規事業の構想、店舗の立ち上げ、組織の刷新、キャリアの相談。<br/>
          まずはお話を聞かせてください。
        </p>

        <div class="mt-16 grid grid-cols-12 gap-8 border-t border-line pt-12">
          <div class="col-span-12 md:col-span-6">
            <p class="text-eyebrow mb-5">For Business</p>
            <a href="mailto:contact@encrews.co.jp" class="block text-[20px] md:text-[26px] font-light tracking-tight text-ink border-b border-ink/20 pb-3 hover:border-ink transition-colors">
              contact@encrews.co.jp →
            </a>
            <p class="mt-4 text-[13px] text-ink-2 font-light leading-[1.9]">
              新規事業・店舗開発・組織開発のご依頼。
            </p>
          </div>
          <div class="col-span-12 md:col-span-6">
            <p class="text-eyebrow mb-5">For Career</p>
            <a href="#" class="block text-[20px] md:text-[26px] font-light tracking-tight text-ink border-b border-ink/20 pb-3 hover:border-ink transition-colors">
              Join the crew →
            </a>
            <p class="mt-4 text-[13px] text-ink-2 font-light leading-[1.9]">
              事業を立ち上げる仲間募集。職種・経験不問。
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
