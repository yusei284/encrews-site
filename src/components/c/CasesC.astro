---
const cases = [
  { id: "case_01", title: "the_bagel @ kagurazaka", cat: "store_launch · brand · f&b", year: "2024 — 2026", body: "米粉×グラスフェッドバターという新ジャンルのベーグル専門店を、物件選定からブランド設計、内装、メニュー開発、採用、PR、グランドオープン運営までフル伴走。", status: "shipping" },
  { id: "case_02", title: "engineer_led_studio", cat: "it · talent · org", year: "2020 — ongoing", body: "成長企業の社内基盤刷新と、新卒・中途採用、組織設計までを一気通貫で支援。技術と人の両軸で事業の伸びをつくる。", status: "running" },
  { id: "case_03", title: "founders_notebook", cat: "community · brand", year: "2021 — ongoing", body: "起業家・クリエイター向けの月次ビジネスセッション。次の挑戦を生む合言葉として、毎月東京で開催中。", status: "running" },
];
const statusColor = {
  shipping: "bg-amber-600/10 text-amber-700 border-amber-700/20",
  running:  "bg-emerald-600/10 text-emerald-700 border-emerald-700/20",
};
---
<section id="cases" class="py-32 md:py-48 border-t border-line">
  <div class="container-x">
    <div class="grid grid-cols-12 gap-8 mb-20 md:mb-28">
      <div class="col-span-12 md:col-span-3">
        <p class="font-mono text-[11px] tracking-tight text-ink-3">{"// 04 — cases"}</p>
      </div>
      <div class="col-span-12 md:col-span-9 flex items-end justify-between flex-wrap gap-4">
        <h2 class="text-display text-[36px] md:text-[52px] lg:text-[72px] text-ink max-w-3xl">
          Active deployments.
        </h2>
        <a href="#" class="font-mono text-[12px] tracking-tight text-ink-3 hover:text-ink transition-colors border-b border-ink/20 pb-1">view_all →</a>
      </div>
    </div>

    <div class="space-y-8">
      {cases.map((c) => (
        <article class="border border-line rounded-sm p-6 md:p-10 hover:bg-ink/[0.015] transition-colors group">
          <div class="grid grid-cols-12 gap-6">
            <div class="col-span-12 md:col-span-3 font-mono">
              <p class="text-[11px] text-ink-3 tracking-tight">{c.id}</p>
              <p class="text-[11px] text-ink-3 tabular-nums tracking-tight mt-1">{c.year}</p>
              <span class={`mt-3 inline-block px-2 py-[2px] text-[10px] tracking-tight border rounded-sm ${statusColor[c.status] ?? "bg-ink/5 text-ink-2 border-line"}`}>
                ● {c.status}
              </span>
            </div>
            <div class="col-span-12 md:col-span-9">
              <h3 class="font-mono text-[22px] md:text-[28px] lg:text-[34px] text-ink font-medium tracking-tight">{c.title}</h3>
              <p class="font-mono text-[11px] text-ink-3 tracking-tight mt-2">[{c.cat}]</p>
              <p class="mt-6 text-[14px] leading-[1.95] text-ink-2 font-light max-w-3xl">{c.body}</p>
              <a href="#" class="mt-8 inline-flex items-center gap-2 font-mono text-[12px] text-ink border-b border-ink/30 pb-1 hover:gap-4 hover:border-ink transition-all">
                ./read_story →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
