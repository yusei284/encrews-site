---
const services = [
  { id: "01", key: "it_product",   en: "IT & Product",  jp: "IT開発・プロダクト設計", body: "Web · モバイル · 業務システム · AI実装。要件整理から設計・開発・運用まで。", stack: "ts, py, swift" },
  { id: "02", key: "brand_pr",     en: "Brand & PR",    jp: "ブランディング・PR",     body: "コーポレート／プロダクトのブランド設計、SNS戦略、メディアリレーション、コンテンツ。", stack: "design, copy" },
  { id: "03", key: "store_launch", en: "Store Launch",  jp: "店舗開発・F&B立ち上げ",  body: "出店戦略、内装ディレクション、メニュー開発、オペレーション設計、開業PR。", stack: "ops, retail" },
  { id: "04", key: "talent",       en: "Talent & Org",  jp: "人材・組織開発",         body: "新卒中途のキャリア伴走、企業の組織開発、採用ブランディング。", stack: "hr, coach" },
  { id: "05", key: "community",    en: "Community",     jp: "コミュニティ運営",       body: "ビジネス交流会・業界横断セミナー・リーダーシップコミュニティの企画と運営。", stack: "events" },
  { id: "06", key: "logistics",    en: "Logistics",     jp: "物流・運送",             body: "EC物流、定期配送、店舗間配送など、事業フェーズに応じた物流設計。", stack: "ops" },
];
---
<section id="work" class="py-32 md:py-48 border-t border-line">
  <div class="container-x">
    <div class="grid grid-cols-12 gap-8 mb-20 md:mb-28">
      <div class="col-span-12 md:col-span-3">
        <p class="font-mono text-[11px] tracking-tight text-ink-3">{"// 03 — modules"}</p>
      </div>
      <div class="col-span-12 md:col-span-9">
        <h2 class="text-display text-[36px] md:text-[52px] lg:text-[72px] text-ink max-w-3xl">
          import { '{ everything }' }<br/>
          from "encrews"
        </h2>
        <p class="mt-6 font-mono text-[12px] text-ink-3">$ ls ./services/</p>
      </div>
    </div>

    <div class="border border-line rounded-sm overflow-hidden">
      <div class="grid grid-cols-12 gap-4 px-6 md:px-8 py-3 bg-ink/[0.02] border-b border-line font-mono text-[10px] tracking-tight text-ink-3 uppercase">
        <div class="col-span-1">id</div>
        <div class="col-span-3">module</div>
        <div class="col-span-6">description</div>
        <div class="col-span-2 text-right">stack</div>
      </div>
      {services.map((s, i) => (
        <div class={`grid grid-cols-12 gap-4 px-6 md:px-8 py-6 ${i !== services.length - 1 ? "border-b border-line" : ""} font-mono hover:bg-ink/[0.02] transition-colors group`}>
          <div class="col-span-1 text-[11px] text-ink-3 tabular-nums pt-1">{s.id}</div>
          <div class="col-span-12 md:col-span-3">
            <p class="text-[15px] md:text-[17px] text-ink font-medium tracking-tight">{s.en.toLowerCase().replace(/[^a-z0-9]/g," ").trim().replace(/\s+/g,"_")}</p>
            <p class="text-[11px] text-ink-3 mt-1 font-sans">{s.jp}</p>
          </div>
          <div class="col-span-12 md:col-span-6 text-[13px] leading-[1.85] text-ink-2 font-sans font-light pt-1">
            {s.body}
          </div>
          <div class="col-span-12 md:col-span-2 text-right pt-1">
            <span class="text-[10px] text-ink-3 tracking-tight">[{s.stack}]</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
