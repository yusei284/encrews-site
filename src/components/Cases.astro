---
const cases = [
  {
    no: "Case / 01",
    title: "THE BAGEL",
    cat: "Store Launch · Brand · F&B",
    year: "2024 — 2026",
    location: "神楽坂",
    body: "韓国の米粉グルテンフリーをベースに、グラスフェッドバターを使った「日本×フランス×韓国」のクロスオーバーベーグル。2026年6月8日(ベーグルの日)、神楽坂の路地でグランドオープン。立ち上げ・ブランディング・運営の全工程に伴走。",
    img: "/images/case_bagel.jpg",
  },
  {
    no: "Case / 02",
    title: "Book Production",
    cat: "Publishing · Brand",
    year: "2018 — Ongoing",
    location: "",
    body: "著者の言葉を本にして、市場に届ける。これまで携わった書籍は累計18冊・累計20万部超。編集・販促・講演会運営・SEO・YouTube展開まで、本を起点にしたブランディング全体を設計。",
    img: "/images/story_book.jpg",
  },
];
---
<section id="cases" class="py-32 md:py-48 border-t border-line">
  <div class="container-x">
    <div class="grid grid-cols-12 gap-8 mb-20 md:mb-28">
      <div class="col-span-12 md:col-span-3">
        <p class="text-eyebrow">04 — Selected Cases</p>
      </div>
      <div class="col-span-12 md:col-span-9 flex items-end justify-between flex-wrap gap-4">
        <h2 class="text-display text-[36px] md:text-[52px] lg:text-[72px] text-ink max-w-3xl">
          いま走っている、<br/>
          いくつかの航海。
        </h2>
        <a href="#" class="text-[13px] tracking-tight border-b border-ink/30 pb-1 hover:border-ink transition-colors">
          View all →
        </a>
      </div>
    </div>

    <div class="space-y-24 md:space-y-36">
      {cases.map((c, i) => (
        <article class="grid grid-cols-12 gap-8 items-start">
          <div class={`col-span-12 md:col-span-7 ${i % 2 === 1 ? "md:order-2 md:col-start-6" : ""}`}>
            <div class="aspect-[4/3] overflow-hidden bg-[#0a0a0a]">
              <img src={c.img} alt={c.title} class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-1000" loading="lazy"/>
            </div>
          </div>
          <div class={`col-span-12 md:col-span-5 ${i % 2 === 1 ? "md:order-1" : ""}`}>
            <p class="text-[11px] tabular-nums tracking-[0.18em] uppercase text-ink-3">{c.no}</p>
            <h3 class="mt-6 text-[28px] md:text-[40px] lg:text-[48px] font-light tracking-tight leading-tight text-ink">{c.title}</h3>
            <div class="mt-4 flex items-center gap-4 text-[12px] text-ink-3 tracking-tight flex-wrap">
              <span>{c.cat}</span>
              <span class="opacity-30">|</span>
              <span class="tabular-nums">{c.year}</span>
              {c.location && <><span class="opacity-30">|</span><span>{c.location}</span></>}
            </div>
            <p class="mt-8 text-[14px] leading-[1.9] text-ink-2 font-light max-w-md">{c.body}</p>
            <a href="#" class="mt-10 inline-flex items-center gap-2 text-[13px] tracking-tight border-b border-ink pb-1 hover:gap-4 transition-all">
              Read story →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
