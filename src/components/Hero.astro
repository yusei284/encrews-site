---
---
<section class="relative min-h-[100svh] flex flex-col justify-end pt-28 pb-16 md:pb-20">
  <div class="container-x w-full">
    <div class="fade-in flex items-center gap-3 text-eyebrow mb-10">
      <span class="w-6 h-px bg-ink-3"></span>
      <span>Encrews / Est. 2018 / Tokyo</span>
    </div>

    <h1 class="fade-in-1 text-display text-[44px] sm:text-[64px] md:text-[88px] lg:text-[112px] xl:text-[128px] text-ink max-w-[1200px]">
      Build with people,<br/>not for them.
    </h1>

    <div class="mt-14 grid grid-cols-12 gap-8 items-end">
      <div class="col-span-12 md:col-span-5 fade-in-2">
        <p class="text-[14px] md:text-[15px] leading-[1.95] text-ink-2 max-w-md font-light">
          元エンジニアが、人と店と事業を立ち上げる。<br/>
          IT・PR・店舗開発・人材育成を横断する、<br/>
          伴走型のパートナー会社です。
        </p>
      </div>
      <div class="col-span-12 md:col-span-4 md:col-start-9 fade-in-3">
        <div class="hairline mb-5"></div>
        <div class="grid grid-cols-2 gap-x-6 gap-y-5 text-[12px] tracking-tight">
          <div>
            <p class="text-ink-3 mb-1">Founded</p>
            <p class="text-ink tabular-nums">2018, Tokyo</p>
          </div>
          <div>
            <p class="text-ink-3 mb-1">Team</p>
            <p class="text-ink">A few crew</p>
          </div>
          <div>
            <p class="text-ink-3 mb-1">Sectors</p>
            <p class="text-ink">IT · F&amp;B · Talent</p>
          </div>
          <div>
            <p class="text-ink-3 mb-1">Now</p>
            <p class="text-ink">THE BAGEL ⟶</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="fade-in-4 absolute bottom-5 left-0 right-0">
    <div class="container-x flex items-center justify-between text-[10px] tracking-[0.2em] uppercase text-ink-3">
      <span class="tabular-nums">Index 01 / 05</span>
      <span class="hidden sm:inline">Scroll ↓</span>
    </div>
  </div>
</section>
